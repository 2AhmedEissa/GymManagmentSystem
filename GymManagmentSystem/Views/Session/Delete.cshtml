@model SessionViewModel
@{
    ViewData["Title"] = "Delete Session";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white text-center py-4">
                    <i class="bi bi-exclamation-triangle-fill display-5 mb-2 d-block"></i>
                    <h3 class="mb-0">Delete Session</h3>
                </div>

                <div class="card-body p-4">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                            <i class="bi bi-x-circle-fill me-2 fs-5"></i>
                            <div>@ViewBag.ErrorMessage</div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning text-start mb-4" role="alert">
                            <strong>Warning!</strong> Are you sure you want to delete this session? This action cannot be undone.
                        </div>
                    }

                    <div class="detail-box p-3 border rounded mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h5 class="mb-0 text-primary-color">@Model.CategoryName</h5>
                            <span class="badge bg-secondary">@Model.Status</span>
                        </div>
                        <p class="text-muted small mb-3">@Model.Description</p>
                        <div class="row g-2 small">
                            <div class="col-sm-6">
                                <i class="bi bi-person-circle text-primary-color me-1"></i>
                                <strong>Trainer:</strong> @Model.TrainerName
                            </div>
                            <div class="col-sm-6">
                                <i class="bi bi-people text-primary-color me-1"></i>
                                <strong>Booked:</strong> @Model.BookedSlots / @Model.Capacity spots
                            </div>
                            <div class="col-sm-6">
                                <i class="bi bi-calendar3 text-primary-color me-1"></i>
                                <strong>Date:</strong> @Model.DateDisplay
                            </div>
                            <div class="col-sm-6">
                                <i class="bi bi-clock text-primary-color me-1"></i>
                                <strong>Time:</strong> @Model.TimeRangeDisplay
                            </div>
                        </div>
                    </div>

                    <form asp-controller="Session" asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post">
                        <div class="d-flex justify-content-between gap-3">
                            <a asp-controller="Session" asp-action="Index" class="btn btn-outline flex-fill">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger flex-fill">
                                <i class="bi bi-trash me-1"></i>Confirm Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

